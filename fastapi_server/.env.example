# Copy to fastapi_server/.env and fill in the real key (never commit .env).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Sign in with Google. The client id is public - the browser sends it in every
# sign-in - but the server needs it too, to reject tokens minted for other
# sites. Create an "OAuth client ID" of type "Web application" at
# https://console.cloud.google.com/apis/credentials and list the site origins
# (https://metaylimvemekirim.co.il, http://localhost:4200) under "Authorized
# JavaScript origins". Leave "Authorized redirect URIs" empty - the token
# arrives in the page and the browser never navigates away - and ignore the
# client secret, which this flow has no use for.
# Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=

# Sign in with Facebook. Create an app at https://developers.facebook.com/apps
# and add the "Facebook Login" product. Under Facebook Login > Settings turn on
# "Login with the JavaScript SDK" and list the site origins under "Allowed
# Domains for the JavaScript SDK" - that is the setting this flow obeys, not
# "Valid OAuth Redirect URIs", which governs the server-side redirect flow we
# do not use. A new app is in Development mode, where only accounts with a role
# on it can log in; it must be switched to Live for members to use the button.
# The secret never leaves the server; it is what proves to Facebook that a
# token was issued to this app and not another.
# Leave either blank to hide the Facebook button.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
